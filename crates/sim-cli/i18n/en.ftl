cli-usage = Usage: sim-cli list | run MACHINE [--move a,b | --cycle | --trajectory FILE | --path FILE [--time-optimal]] [--time SECONDS] [--disable-at SECONDS] [--every STEPS] | analyze MACHINE [--trajectory FILE | --path FILE [--time-optimal]] [--points FILE] [--breakdown FILE] [--budget FILE] | sweep MACHINE [--motor N] [--from HZ] [--to HZ] [--count N] [--amplitude NM] | optimise MACHINE [--runs N] | search MACHINE [--series PREFIX] [--gearboxes SERIES] | verdicts MACHINE [--bands [--samples N [--seed S] | --worst]] | sensitivity MACHINE [--delta FRACTION] [--group TABLE]... | step MACHINE [--axis N] [--size M] [--time SECONDS] | bode MACHINE [--axis N] [--from HZ] [--to HZ] [--count N] [--amplitude M] | tuning MACHINE | margins MACHINE [--bands] | replay MACHINE --trace FILE | fit MACHINE [--trace FILE] [--sweep FILE [--sweep-motor N] [--amplitude NM]] | compare MACHINE --effect NAME [--signal ID]... [--differences FILE] | fmu MACHINE --out FILE.fmu [--binary FILE]...; for all: [--config FILE] [--motor ARTICLE] [--supply 230v|400v] [--gearbox SIZE-FRAME-RATIO] [--set path=value]... [--out FILE] [--lang en|de]. A path file has one piece per line, from where the machine stands: line,a,b (straight to the point), arc,a,b,ca,cb,cw|ccw (on a circle around the centre ca,cb to the point a,b) or spline,a,b (on a smooth curve through the point; lines of spline that follow one another form one curve). Its timing is planned within the axis limits, with --time-optimal as fast as the motors allow.
cli-error-unknown-machine = Unknown machine: { $arg }
cli-error-bad-argument = Cannot read this argument: { $arg }
cli-error-unknown-option = This command has no such option: { $arg }
cli-error-missing-value = This option needs a value: { $arg }
cli-error-conflict = Only one of these options can be given at a time: { $arg }
cli-error-io = File error: { $arg }
cli-error-fmu-binary = The FMU's binary cannot be read; build it with cargo build --release -p sim-fmi, or name it with --binary: { $arg }
cli-search-screened = Ruled out by catalogue numbers against the axis limits, without simulating a cycle: { $arg } candidates
cli-error-worst = --worst needs --bands and goes without --samples and --seed
cli-worst-runs = Cycles simulated in the search for the worst corners: { $arg }
