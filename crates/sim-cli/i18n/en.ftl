cli-help-run-8 = --every STEPS  Writes every n-th base step, 16 by default.
cli-help-run-9 = --disable-at SECONDS  Switches the drives off then (brakes hold, or the axes coast or fall).
cli-help-run-10 = --stop-at SECONDS  Stops the machine then.
cli-help-run-11 = --stop-category 0|1|2  The category of that stop.
