cli-help-fmu-4 = --fmi 2|3  Die FMI-Version, standardmäßig 2.

cli-help-options-1 = Optionen, die jeder Befehl kennt:
cli-help-options-2 = --machine-file DATEI  Eine in einer Datei (.toml oder .json) definierte Maschine, statt MASCHINE.
cli-help-options-3 = --config DATEI  Eine Konfigurationsdatei statt der Standardkonfiguration der Maschine.
cli-help-options-4 = --set pfad=wert  Setzt einen Wert über die Konfiguration; darf wiederholt werden.
cli-help-options-5 = --catalog ORDNER  Ein Katalogordner statt des eingebauten.
cli-help-options-6 = --motor ARTIKEL  Ein Katalogmotor statt des Motors der Konfiguration.
cli-help-options-7 = --supply NAME  230v, 400v, s120, s210new-230v, s210new-400v oder HERSTELLER-VOLTSv.
cli-help-options-8 = --gearbox GRÖSSE-BAUFORM-ÜBERSETZUNG  Ein Katalog-Getriebe statt des Getriebes der Konfiguration.
cli-help-options-9 = --drive ARTIKEL  Ein Katalog-Antrieb statt des Antriebs der Konfiguration.
cli-help-options-10 = --belt PROFIL-BREITE  Ein Katalog-Riemen statt des Riemens der Konfiguration.
cli-help-options-11 = --axis NAME  Eine Katalog-Achse statt der Achse der Konfiguration.
cli-help-options-12 = --out DATEI  Schreibt das CSV in eine Datei statt auf die Standardausgabe.
cli-help-options-13 = --lang en|de  Die Sprache der Meldungen.
cli-help-options-14 = --help, -h  Diese Hilfe.   --version, -V  Die Version.

cli-help-paths-1 = Eine Pfaddatei hat ein Stück je Zeile, von dort, wo die Maschine steht:
cli-help-paths-2 = line,a,b  gerade zum Punkt a,b
cli-help-paths-3 = arc,a,b,ca,cb,cw|ccw  auf einem Kreis um den Mittelpunkt ca,cb zum Punkt a,b
cli-help-paths-4 = spline,a,b  auf einer glatten Kurve durch den Punkt; aufeinanderfolgende spline-Zeilen bilden eine Kurve
cli-help-paths-5 = Bei drei Achsen: line,x,y,z   spline,x,y,z   arc,x,y,z,cx,cy,cz,cw|ccw (in der Ebene von Start, Ende, Mittelpunkt).
cli-help-paths-6 = Ihr Zeitverlauf wird in den Achsgrenzen geplant; mit --time-optimal so schnell, wie die Motoren erlauben.
cli-help-paths-7 = Eine Datei auf .nc, .ngc, .gcode, .g, .cnc oder .tap wird als G-Code gelesen (G0, G1, G2, G3, F, G17/G18/G19,
cli-help-paths-8 = G20/G21, G90/G91), .src als KUKA-KRL (PTP, LIN, CIRC), .mod oder .prg als ABB-RAPID (MoveL, MoveJ, MoveC),
cli-help-paths-9 = und Zeilen MoveL,MoveJ,MoveC als Roboterbewegungen (siehe docs/de/benutzerhandbuch.md).

cli-help-units-1 = Spalten und Schlüssel in kg, N, N m, rad oder rad/s haben die eigene Einheit der Achse: bei einem Linearmotor N,
cli-help-units-2 = m/s und m, und moved_mass_kg, viscous_friction_n_s_m, coulomb_friction_n und constant_force_n des
cli-help-units-3 = Anpassungsberichts haben bei einer Drehachse kg m2, N m s/rad, N m und N m.
cli-help-units-4 = Letzte Spalten nennen die Einheiten: torque_unit,speed_unit bei analyze, speed_unit,torque_unit bei --points,
cli-help-units-5 = torque_unit bei --breakdown, search und transmission, units bei fit (leer, wo eine Zeile keine hat).
