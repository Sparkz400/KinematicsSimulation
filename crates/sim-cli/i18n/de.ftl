cli-error-unknown-machine = Unbekannte Maschine: { $arg }
cli-error-bad-argument = Dieses Argument ist nicht lesbar: { $arg }
cli-error-no-workspace = Diese Maschine hat keine Arbeitsraumkarte: Sie braucht drei Achsen und eine Kinematik, die eine Konditionszahl angibt. { $arg }
cli-error-unknown-option = Diese Option kennt der Befehl nicht: { $arg }
cli-error-missing-value = Dieser Option fehlt ihr Wert: { $arg }
cli-error-conflict = Von diesen Optionen kann nur eine zugleich angegeben werden: { $arg }
cli-error-io = Dateifehler: { $arg }
cli-error-fmu-binary = Die Binärdatei der FMU ist nicht lesbar; mit cargo build --release -p sim-fmi bauen oder mit --binary angeben: { $arg }
cli-search-screened = Nicht simuliert (ein Teil, das die Konfiguration nicht aufnimmt, oder ein Zyklus, der nicht läuft; der Grund steht in der Tabelle): { $arg } Kandidaten
cli-search-own-gearbox = Kein Getriebe der Baureihe passt, daher mit dem Getriebe der Konfiguration versucht (Getriebe leer in der Tabelle): { $arg } Kandidaten
cli-search-time = Dauer der Suche auf { $arg }
cli-search-robust-changed = In den Fehlerbändern (ungünstigste Ecke der Grenzen jedes Kandidaten) ändert sich die Reihenfolge der besten Kandidaten: siehe die Spalten robust_*
cli-search-robust-same = In den Fehlerbändern (ungünstigste Ecke der Grenzen jedes Kandidaten) bleibt die Reihenfolge der besten Kandidaten, wie sie ist
cli-transmission-optimum = Klassisches Optimum (kleinstes Moment je Beschleunigung) und bester Wert für den Zyklus von { $arg }
cli-error-worst = --worst braucht --bands und geht nicht zusammen mit --samples und --seed
cli-error-axis-index = --axis-index nimmt die Nummer einer Achse der Maschine, eine ganze Zahl von 0 bis { $arg }
cli-worst-runs = Für die Suche nach den ungünstigsten Ecken simulierte Zyklen: { $arg }
cli-optimise-runs = Simulierte Zyklen: Suche + Fehlerbänder { $arg }
cli-optimise-runs-worst = Simulierte Zyklen: Suche + ungünstigste Ecken { $arg }
cli-report-pass = Bericht geschrieben, alle Prüfungen bestanden: { $arg }
cli-report-fail = Bericht geschrieben, Prüfungen nicht bestanden: { $arg }
cli-planned-clearance = Geplante Bahn: kleinster Abstand zu den Hindernissen { $arg } mm
cli-planned-contact = Geplante Bahn: erste Berührung eines Hindernisses in der Lage { $arg }
cli-run-clearance = Lauf: kleinster Abstand zu den Hindernissen { $arg } mm
cli-run-contact = Lauf: erste Berührung eines Hindernisses (Name: Zeit, Geschwindigkeit des Werkzeugs, Lage) { $arg }
cli-run-impact = Lauf: größte Kontaktkraft, Kontaktkraft jetzt und Aufprallenergie { $arg }
cli-run-fault = Lauf: die Antriebe haben abgeschaltet (Überwachung: Motor, Zeit; Störreaktion je Motor) { $arg }
cli-run-stopping = Lauf: Anhalteweg je Achse ab der Abschaltung (die Maschine stand um) { $arg }
cli-thermal-start-cold = Thermischer Start: kalt (Teile und Wicklungen bei den Temperaturen, mit denen der Lauf begann)
cli-thermal-start-warm = Thermischer Start: warm, bei den Übertemperaturen, auf die der Zyklus einschwingt; größte Änderung einer Übertemperatur im gemessenen Durchlauf { $arg } K
cli-thermal-start-unsettled = Thermischer Start: warm, aber in den Warmdurchläufen NICHT konvergiert, auch nicht über eine Periode von bis zu 3 Durchläufen; größte Änderung einer Übertemperatur im gemessenen Durchlauf { $arg } K
cli-thermal-start-aperiodic = Thermischer Start: warm, aber NICHT konvergiert: der Zyklus wiederholt sich nicht. Zwei Durchläufe, bei denselben Übertemperaturen begonnen, schwangen bis zu { $arg } K auseinander ein: was ein Durchlauf in Bewegung lässt (eine noch pendelnde Last), trägt sich in den nächsten und belastet die Motoren anders, was keine Starttemperatur einschwingen lässt
cli-thermal-start-period = Thermischer Start: der Zyklus wiederholt sich erst alle { $arg } Durchläufe; seine Übertemperaturen schwingen über diese Periode ein, die als eine gemessen wird
cli-conveyor = Förderband: Griffe, Folgefehler beim Greifen längs des Bands, verpasste Teile { $arg }
cli-stop-worst = Ungünstigster Stopp: ausgelöst bei { $arg }
cli-stop-verdict = Bewertung des Stopps: { $arg }
cli-accuracy-axis = Genauigkeit nach ISO 230-2, Achse { $arg } (B Umkehrspanne, R beidseitige Wiederholpräzision, E systematische Abweichung, M Spanne der mittleren Abweichung, A Positionsgenauigkeit)
cli-accuracy-tool = Genauigkeit am Werkzeug nach ISO 9283, über die Achsen in Metern: { $arg } (AP Posegenauigkeit, RP Pose-Wiederholgenauigkeit, vAP zwischen den Anfahrrichtungen)
cli-accuracy-verdict = Bewertung der Genauigkeit: { $arg }

fit-report-written = Bericht geschrieben: { $arg }

cli-sensitivity-zero = Nicht eingeordnet: { $arg } ist 0 und hat keinen Bereich in [bounds] (--delta von 0 ist 0); dort einen angeben, um ihn zu variieren.
cli-sensitivity-runs = Für die globale Empfindlichkeit simulierte Zyklen: { $arg }
cli-measure-first = Diese zuerst messen: { $arg }
cli-hint-nearest = (meinten Sie { $arg }?)
cli-hint-value = = { $arg }

cli-usage-hint = Falsche oder fehlende Argumente. `sim-cli help { $arg }` nennt die Optionen dieses Befehls; `sim-cli help` nennt die Befehle.
cli-usage-unknown = Unbekannter Befehl oder Hilfethema: { $arg }. `sim-cli help` nennt die Befehle.
cli-help-overview-1 = sim-cli startet den Simulator auf der Kommandozeile und gibt die Ergebnisse als CSV auf der Standardausgabe aus.
cli-help-overview-2 = Aufruf: sim-cli BEFEHL MASCHINE [OPTIONEN]   (MASCHINE ist eine Kennung aus `sim-cli list` oder --machine-file DATEI)
cli-help-overview-3 = Befehle:
cli-help-more-1 = Mehr Hilfe:
cli-help-more-2 = sim-cli help BEFEHL  die Optionen eines Befehls (auch: sim-cli BEFEHL --help)
cli-help-more-3 = sim-cli help options  die Optionen, die jeder Befehl kennt
cli-help-more-4 = sim-cli help paths  die Formate von Pfaddateien und Programmen
cli-help-more-5 = sim-cli help units  die Einheiten der Spalten
cli-help-more-6 = sim-cli --version  die Version
cli-help-more-7 = Beendigungscodes: 0 alles, was der Befehl beurteilt, besteht; 1 eine Prüfung fällt durch (die Tabelle steht vollständig da);
cli-help-more-8 = 2 ein Aufruf- oder Konfigurationsfehler (eine Zeile auf der Fehlerausgabe).

cli-help-brief-list = Listet die registrierten Maschinen, je Zeile Kennung und Name.
cli-help-brief-run = Simuliert eine Bewegung oder den Zyklus und schreibt jedes Signal.
cli-help-brief-analyze = Fährt den Zyklus oder eine Bewegung und fasst die Last jedes Motors zusammen.
cli-help-brief-sweep = Misst den Frequenzgang eines Motors, Moment auf Drehzahl.
cli-help-brief-optimise = Verkürzt den Zyklus, solange jedes Urteil besteht.
cli-help-brief-search = Probiert Katalogmotoren, Getriebe und Antriebe am Zyklus und reiht sie.
cli-help-brief-transmission = Fährt das Getriebeverhältnis oder den Riemenscheibenradius durch und findet den besten Wert.
cli-help-brief-compare-kinematics = Reiht Maschinen für eine Pick-and-Place-Aufgabe.
cli-help-brief-verdicts = Beurteilt den Zyklus an den Motordaten und den Bemessungswerten der Konfiguration.
cli-help-brief-sensitivity = Reiht die Parameter danach, wie stark sie die Ergebnisse verschieben.
cli-help-brief-step = Sprungantwort des Lageregelkreises einer Achse.
cli-help-brief-bode = Frequenzgang des geschlossenen Lageregelkreises einer Achse.
cli-help-brief-tuning = Eine Zeile je Achse: Anstiegszeit, Überschwingen, Ausregelzeit, Bandbreite.
cli-help-brief-margins = Stabilitätsreserven des Drehzahlregelkreises jedes Motors.
cli-help-brief-modes = Die Resonanzen der Maschine über den Hub einer Achse.
cli-help-brief-workspace = Ein Schnitt der Arbeitsraumkarte: Erreichbarkeit, Konditionszahl, Beschleunigung.
cli-help-brief-replay = Fährt die Lagesollwerte einer Antriebsaufzeichnung durch den Simulator.
cli-help-brief-fit = Passt die Werte der Konfiguration an eine Aufzeichnung, einen Frequenzgang oder einen Datensatz an.
cli-help-brief-identify = Bestimmt den Antriebsstrang eines Motors aus seiner eigenen Aufzeichnung, ohne Konfiguration.
cli-help-brief-check-dataset = Prüft, ob ein Datensatzordner veröffentlicht werden kann.
cli-help-brief-compare = Fährt den Zyklus mit einem Effekt an und aus und schreibt beides.
cli-help-brief-stop = Hält die Maschine zu Zeitpunkten des Zyklus an und findet den ungünstigsten.
cli-help-brief-accuracy = Statische Positioniergenauigkeit und Wiederholgenauigkeit (ISO 230-2, ISO 9283).
cli-help-brief-report = Schreibt den Auslegungsbericht mit jedem Urteil, als HTML oder PDF.
cli-help-brief-fmu = Schreibt die Maschine als FMU für die Co-Simulation.

cli-help-list-1 = sim-cli list [--lang en|de]
cli-help-run-1 = sim-cli run MASCHINE [OPTIONEN]
cli-help-run-2 = --move a,b  Fährt in diese Lage (ein Wert je Achse).
cli-help-run-3 = --cycle  Fährt den Zyklus der Konfiguration.
cli-help-run-4 = --trajectory DATEI  Fährt die Lagen zu Zeiten aus DATEI ab.
cli-help-run-5 = --path DATEI  Fährt eine Pfaddatei oder ein Programm ab (help paths).
cli-help-run-6 = --time-optimal  Mit --path: so schnell, wie die Motoren erlauben, nicht in den Achsgrenzen.
cli-help-run-7 = --time SEKUNDEN  Simulierte Zeit, standardmäßig 2.
cli-help-run-8 = --every SCHRITTE  Schreibt jeden n-ten Grundschritt, standardmäßig 16.
cli-help-run-9 = --disable-at SEKUNDEN  Schaltet dann die Antriebe ab (Bremsen halten, oder die Achsen laufen aus oder fallen).
cli-help-run-10 = --stop-at SEKUNDEN  Hält die Maschine dann an.
cli-help-run-11 = --stop-category 0|1|2  Die Kategorie dieses Halts.
cli-help-analyze-1 = sim-cli analyze MASCHINE [OPTIONEN]
cli-help-analyze-2 = --trajectory DATEI  Untersucht die Lagen zu Zeiten aus DATEI statt des Zyklus.
cli-help-analyze-3 = --path DATEI  Untersucht eine Pfaddatei oder ein Programm (help paths).
cli-help-analyze-4 = --time-optimal  Mit --path: so schnell, wie die Motoren erlauben.
cli-help-analyze-5 = --points DATEI  Schreibt die Moment-Drehzahl-Punkte jedes Motors.
cli-help-analyze-6 = --breakdown DATEI  Schreibt Spitze und Effektivwert jedes Anteils am Moment jedes Motors.
cli-help-analyze-7 = --budget DATEI  Schreibt, wohin die aus der Versorgung entnommene Energie ging.
cli-help-sweep-1 = sim-cli sweep MASCHINE [OPTIONEN]
cli-help-sweep-2 = --motor N  Der anzuregende Motor (seine Nummer).
cli-help-sweep-3 = --from HZ  Niedrigste Frequenz, standardmäßig 5.
cli-help-sweep-4 = --to HZ  Höchste Frequenz, standardmäßig 500.
cli-help-sweep-5 = --count N  Anzahl der Frequenzen.
cli-help-sweep-6 = --amplitude NM  Amplitude des Sinusmoments.
cli-help-optimise-1 = sim-cli optimise MASCHINE [OPTIONEN]
cli-help-optimise-2 = --runs N  Höchstens so viele Zyklen werden simuliert.
cli-help-optimise-3 = --nominal  Beurteilt wie geschrieben, nicht in den Fehlerbändern der [bounds] der Konfiguration.
cli-help-optimise-4 = --worst  Beurteilt an der ungünstigsten Ecke aller Grenzen zugleich (etwa 2000 Zyklen).
cli-help-optimise-5 = --pareto DATEI  Schreibt die probierten Zyklen: Zeit gegen Last.
cli-help-optimise-6 = --path DATEI  Optimiert für eine Pfaddatei oder ein Programm (help paths).
cli-help-optimise-7 = --time-optimal  Mit --path: so schnell, wie die Motoren erlauben.
cli-help-search-1 = sim-cli search MASCHINE [OPTIONEN]
cli-help-search-2 = --vendor NAME|all  Nur die Versorgungen dieses Herstellers oder aller.
cli-help-search-3 = --series PRÄFIX  Nur Motoren, deren Artikelnummer so beginnt.
cli-help-search-4 = --gearboxes SERIE  Probiert auch die passenden Getriebe dieses Herstellers, dieser Serie oder Größe.
cli-help-search-5 = --axes  Probiert auch jeden Motor an den Achsen des Katalogs (Riemenachsen, Spindeln, Führungen).
cli-help-search-6 = --motor-id ID  Dimensioniert diesen Motor einer Maschine mit mehreren; nicht mit --axes.
cli-help-search-7 = --drives paired|neighbours|all  Welche Antriebe mit jedem Motor probiert werden.
cli-help-search-8 = --rank-by KEY  cost, margin, energy, error, thermal, inertia oder NAME=GEWICHT,...
cli-help-search-9 = --weights W,W,...  Bei mehreren --config DATEI: das Gewicht jedes Lastfalls.
cli-help-search-10 = --robust N  Beurteilt die besten N Kandidaten an der ungünstigsten Ecke ihrer Grenzen.
cli-help-search-11 = --path DATEI  Sucht für eine Pfaddatei oder ein Programm (help paths).
cli-help-search-12 = --time-optimal  Mit --path: so schnell, wie die Motoren erlauben.
cli-help-transmission-1 = sim-cli transmission MASCHINE [OPTIONEN]
cli-help-transmission-2 = --key SCHLÜSSEL  gearbox.ratio (Standard) oder geometry.pulley_radius_m.
cli-help-transmission-3 = --from V  Erster Wert der Reihe.
cli-help-transmission-4 = --to V  Letzter Wert der Reihe.
cli-help-transmission-5 = --count N  Anzahl der Werte.
cli-help-transmission-6 = --gearboxes SERIE  Rastet jeden Wert auch auf ein Getriebe dieser Serie ein.
cli-help-compare-kinematics-1 = sim-cli compare-kinematics AUFGABE.toml --machines ID,ID,... [OPTIONEN]
cli-help-compare-kinematics-2 = --machines ID,ID,...  Die Maschinen, die verglichen werden.
cli-help-compare-kinematics-3 = --machine-file DATEI  Eine in einer Datei definierte Maschine; darf wiederholt werden.
cli-help-compare-kinematics-4 = --vendor NAME|all  Nur die Versorgungen dieses Herstellers oder aller.
cli-help-compare-kinematics-5 = --series PRÄFIX  Nur Motoren, deren Artikelnummer so beginnt.
cli-help-compare-kinematics-6 = --gearboxes SERIE  Probiert auch die passenden Getriebe dieser Serie.
cli-help-compare-kinematics-7 = --drives paired|neighbours|all  Welche Antriebe mit jedem Motor probiert werden.
cli-help-compare-kinematics-8 = --rank-by KEY  Wie bei search.
cli-help-verdicts-1 = sim-cli verdicts MASCHINE [OPTIONEN]
cli-help-verdicts-2 = --bands  Beurteilt auch in den Fehlerbändern der [bounds] der Konfiguration (bis 80 s).
cli-help-verdicts-3 = --samples N  Mit --bands: N Läufe mit allen begrenzten Werten zwischen ihren Grenzen.
cli-help-verdicts-4 = --seed S  Mit --samples: der Startwert, standardmäßig 1.
cli-help-verdicts-5 = --worst  Mit --bands: beurteilt an der ungünstigsten Ecke aller Grenzen zugleich.
cli-help-verdicts-6 = --path DATEI  Beurteilt eine Pfaddatei oder ein Programm statt des Zyklus (help paths).
cli-help-verdicts-7 = --time-optimal  Mit --path: so schnell, wie die Motoren erlauben.
cli-help-verdicts-8 = Code 1, wo eine Zeile FAIL sagt; ein Ergebnis, das nicht endlich ist, wird auf stderr genannt.
cli-help-sensitivity-1 = sim-cli sensitivity MASCHINE [OPTIONEN]
cli-help-sensitivity-2 = --delta ANTEIL  Lokal: jeder Parameter um so viel niedriger und höher, standardmäßig 0,2.
cli-help-sensitivity-3 = --method morris|sobol  Global: stattdessen über die ganzen Grenzen.
cli-help-sensitivity-4 = --samples N  Mit --method: die Anzahl der Stichproben.
cli-help-sensitivity-5 = --seed S  Mit --method: der Startwert.
cli-help-sensitivity-6 = --result NAME  Mit --method: ein Ergebnis, das gereiht wird; darf wiederholt werden.
cli-help-sensitivity-7 = --group TABELLE  Variiert nur diese Tabelle der Konfiguration; darf wiederholt werden.
cli-help-step-1 = sim-cli step MASCHINE [OPTIONEN]
cli-help-step-2 = --axis-index N  Die Achse, von 0 gezählt.
cli-help-step-3 = --size M  Größe des Sprungs.
cli-help-step-4 = --time SEKUNDEN  Dauer des Laufs.
cli-help-bode-1 = sim-cli bode MASCHINE [OPTIONEN]
cli-help-bode-2 = --axis-index N  Die Achse, von 0 gezählt.
cli-help-bode-3 = --from HZ  Niedrigste Frequenz.
cli-help-bode-4 = --to HZ  Höchste Frequenz.
cli-help-bode-5 = --count N  Anzahl der Frequenzen.
cli-help-bode-6 = --amplitude M  Amplitude des Lagesinus.
cli-help-tuning-1 = sim-cli tuning MASCHINE [OPTIONEN]
cli-help-tuning-2 = --size M  Größe des Sprungs.
cli-help-tuning-3 = --amplitude M  Amplitude des Lagesinus.
cli-help-margins-1 = sim-cli margins MASCHINE [OPTIONEN]
cli-help-margins-2 = --bands  Misst auch mit den [bounds] der Konfiguration an ihren Grenzen (bis 80 s).
cli-help-margins-3 = Code 1, wo ein Regelkreis instabil ist oder über das Getriebespiel hämmert.
cli-help-modes-1 = sim-cli modes MASCHINE [OPTIONEN]
cli-help-modes-2 = --axis-index N  Die Achse, deren Hub durchfahren wird, von 0 gezählt.
cli-help-modes-3 = --points N  Anzahl der Stellen über den Hub, standardmäßig 21.
cli-help-modes-4 = --shapes  Stattdessen die Moden in der Startlage, mit ihren Formen.
cli-help-workspace-1 = sim-cli workspace MASCHINE [OPTIONEN]
cli-help-workspace-2 = --z Z  Höhe des Schnitts, standardmäßig die Mitte der dritten Achse.
cli-help-workspace-3 = --points N  Knoten je Seite, standardmäßig 61.
cli-help-replay-1 = sim-cli replay MASCHINE --trace DATEI [OPTIONEN]
cli-help-replay-2 = --trace DATEI  Die Antriebsaufzeichnung (CSV).
cli-help-replay-3 = --map DATEI  Welche Spalte der Aufzeichnung welches Signal ist.
cli-help-fit-1 = sim-cli fit MASCHINE [OPTIONEN]   oder   sim-cli fit [MASCHINE] --dataset ORDNER --report ORDNER
cli-help-fit-2 = --trace DATEI  Passt die Starrkörperwerte an eine Antriebsaufzeichnung (CSV) an.
cli-help-fit-3 = --map DATEI  Welche Spalte der Aufzeichnung welches Signal ist.
cli-help-fit-4 = --sweep DATEI  Passt das Zweimassenmodell an einen gemessenen Frequenzgang an.
