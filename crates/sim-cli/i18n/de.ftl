cli-help-identify-7 = --sweep DATEI  Passt stattdessen das Zweimassenmodell an einen gemessenen Frequenzgang an.
cli-help-identify-8 = --step-from SEKUNDEN  Beginn eines Sprungs in der Aufzeichnung, an den der Lageregelkreis angepasst wird.
cli-help-identify-9 = --step-to SEKUNDEN  Ende dieses Sprungs.
cli-help-identify-10 = --motor-inertia KGM2  Das eigene Trägheitsmoment des Motors, wo bekannt.
cli-help-identify-11 = --overlay DATEI  Schreibt die Aufzeichnung neben die Antwort des bestimmten Modells.
cli-help-check-dataset-1 = sim-cli check-dataset ORDNER
cli-help-compare-1 = sim-cli compare MASCHINE --effect NAME [OPTIONEN]
cli-help-compare-2 = --effect NAME  Der Effekt (effects.NAME), der an- und ausgeschaltet wird.
cli-help-compare-3 = --signal ID  Schreibt nur dieses Signal; darf wiederholt werden.
cli-help-compare-4 = --differences DATEI  Schreibt Spitze und Effektivwert der Differenz je Signal.
cli-help-stop-1 = sim-cli stop MASCHINE [OPTIONEN]
cli-help-stop-2 = --category 0|1|2  Die Halt-Kategorie, standardmäßig 0.
cli-help-stop-3 = --points N  Zeitpunkte des Rasters, zu denen angehalten wird.
cli-help-stop-4 = --path DATEI  Hält entlang einer Pfaddatei oder eines Programms an (help paths).
cli-help-stop-5 = --time-optimal  Mit --path: so schnell, wie die Motoren erlauben.
cli-help-stop-6 = Code 1, wo ein Urteil über den ungünstigsten Halt FAIL sagt.
cli-help-accuracy-1 = sim-cli accuracy MASCHINE [OPTIONEN]
cli-help-accuracy-2 = --points N  Ziele je Achse, standardmäßig 5.
cli-help-accuracy-3 = --repeats N  Anfahrten jedes Ziels von jeder Seite, standardmäßig 5.
cli-help-accuracy-4 = --dwell SEKUNDEN  Ruhe an jedem Ziel, standardmäßig 0,3.
cli-help-accuracy-5 = Code 1, wo ein Urteil FAIL sagt.
cli-help-report-1 = sim-cli report MASCHINE --out DATEI [OPTIONEN]
cli-help-report-2 = --out DATEI  Wohin geschrieben wird: .pdf gibt ein PDF, jeder andere Name HTML.
cli-help-report-3 = --bands  Fügt die Fehlerbänder hinzu.
cli-help-report-4 = Code 1, wo eine Prüfung durchfällt (der Bericht wird trotzdem geschrieben).
