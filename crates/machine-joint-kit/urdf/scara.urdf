<?xml version="1.0"?>
<!-- A generic SCARA arm of 600 mm reach and 3 kg payload, for the simulator's examples: two arms about vertical axes,
     a quill that moves down (a ball screw spline), a turning flange with its gripper. All values are estimates of this project. z up. -->
<robot name="scara-example">
  <link name="base_link"/>
  <link name="arm1">
    <inertial>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="arm1"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="0" velocity="0"/>
  </joint>
  <link name="arm2">
    <inertial>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="arm1"/>
    <child link="arm2"/>
    <origin xyz="0.325 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="0" velocity="0"/>
  </joint>
  <link name="quill">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="joint3" type="prismatic">
    <parent link="arm2"/>
    <child link="quill"/>
    <origin xyz="0.275 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.2" effort="0" velocity="0"/>
  </joint>
  <link name="flange">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="quill"/>
    <child link="flange"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="0" velocity="0"/>
  </joint>
</robot>
