<?xml version="1.0"?>
<!-- A generic five-axis arm for the simulator's examples: the six-axis example (six-axis.urdf) without the flange's own
     roll, the flange and gripper merged into the wrist. Its tool points along the flange's x axis, which the wrist's
     pitch joint turns down at zero joints: the flange points down there. Joints: base turn, shoulder, elbow, forearm
     roll, wrist pitch. Five joints give the tool's place and where it points (two angles), not its turn about where it
     points. All values are estimates of this project, not any maker's. z up. -->
<robot name="five-axis-example">
  <link name="base_link"/>
  <link name="link1">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.35" ixy="0" ixz="0" iyy="0.35" iyz="0" izz="0.25"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="0" velocity="0"/>
  </joint>
  <link name="link2">
    <inertial>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.15 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.571" upper="2.356" effort="0" velocity="0"/>
  </joint>
  <link name="link3">
    <inertial>
      <origin xyz="0.08 0 0.08" rpy="0 0 0"/>
      <mass value="7.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.6" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="1.2" effort="0" velocity="0"/>
  </joint>
  <link name="link4">
    <inertial>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.06"/>
    </inertial>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.25 0 0.12" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.3" upper="3.3" effort="0" velocity="0"/>
  </joint>
  <!-- The wrist with the flange and gripper (six-axis.urdf's link5 and link6): its x axis down at zero. -->
  <link name="link5">
    <inertial>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012"/>
    </inertial>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.4 0 0" rpy="0 1.5707963267948966 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="0" velocity="0"/>
  </joint>
  <link name="tool0"/>
  <joint name="flange" type="fixed">
    <parent link="link5"/>
    <child link="tool0"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
  </joint>
</robot>
