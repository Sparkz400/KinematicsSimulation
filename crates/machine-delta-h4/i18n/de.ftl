machine-delta-h4 = Delta nach Quattro-Art (4 Arme, zweiteilige Plattform)
axis-x = X
axis-y = Y
axis-z = Z
axis-c = C (Werkzeugdrehung)
group-axis-x = X-Achse
group-axis-y = Y-Achse
group-axis-z = Z-Achse
group-axis-c = C-Achse (Werkzeugdrehung)
motor-arm-1 = Motor Arm 1
motor-arm-2 = Motor Arm 2
motor-arm-3 = Motor Arm 3
motor-arm-4 = Motor Arm 4
arm-1 = Arm 1
arm-2 = Arm 2
arm-3 = Arm 3
arm-4 = Arm 4
quantity-arm-angle = Armwinkel (nach unten positiv)
quantity-condition-number = Konditionszahl der Jacobi-Matrix
quantity-plate-slide = Verschiebung der Plattformteile gegeneinander
quantity-amplifier-twist = Verdrehung der Übersetzung am Werkzeug
group-kinematics = Kinematik
group-workspace = Arbeitsraum
group-plate = Bewegte Plattform
group-tool = Werkzeug
effect-joint_elasticity = Getriebeelastizität (aus: starres Modell)
effect-forearm_inertia = Unterarme als starre Stäbe mit ihrer Trägheit und Eigendrehung (aus: an Ellbogen und Plattform verteilt)
effect-hard_stops = Anschläge an den Enden des Winkelbereichs der Arme
effect-amplifier_compliance = Das Werkzeug dreht an der Feder der Übersetzung (aus: starr mit der Verschiebung)
effect-amplifier_backlash = Spiel der Übersetzung (Zahnstange, Ritzel, Zahnradstufe)
param-base_radius_m = Basisradius (Mitte bis Schulterachse)
param-plate_radius_m = Radius eines Plattformteils (Teilmitte bis Unterarmpaar)
param-upper_arm_m = Oberarmlänge
param-forearm_m = Unterarmlänge
param-forearm_spacing_m = Abstand der beiden Stäbe eines Unterarmpaars (nur Ansicht)
param-radius_m = Radius
param-top_z_m = Oberkante, Höhe unter der Schulterebene
param-height_edge_m = Höhe am Rand
param-height_centre_m = Höhe in der Mitte
param-max_condition_number = Höchste Konditionszahl der Jacobi-Matrix
param-upper_arm_kg = Masse des Oberarms
param-upper_arm_cg_m = Schwerpunkt des Oberarms ab Gelenk
param-upper_arm_inertia_kgm2 = Trägheitsmoment des Oberarms um das Gelenk
param-elbow_kg = Masse des Ellbogens
param-forearm_pair_kg = Masse eines Unterarmpaars
param-forearm_elbow_share = Anteil der Unterarmmasse am Ellbogen
param-forearm_rod_spin_inertia_kgm2 = Trägheitsmoment eines Unterarmstabs um die eigene Achse
param-plate_part_kg = Masse jedes Plattformteils
param-carriage_kg = Masse des Schlittens (Ritzel, Zahnradstufe, Flansch)
param-pinion_radius_m = Teilkreisradius des Ritzels zwischen den Zahnstangen
param-gear_ratio = Übersetzung der Zahnradstufe hinter dem Ritzel
param-amplifier_stiffness_nm_rad = Drehsteifigkeit der Übersetzung am Werkzeug
param-amplifier_damping_nm_s_rad = Drehdämpfung der Übersetzung am Werkzeug
param-amplifier_backlash_rad = Spiel der Übersetzung am Werkzeug
param-inertia_kgm2 = Trägheitsmoment des Werkzeugs um seine Achse
param-payload_inertia_kgm2 = Trägheitsmoment der Last um die Werkzeugachse
param-max_velocity_rad_s = Höchste Geschwindigkeit [rad/s]
param-max_acceleration_rad_s2 = Höchste Beschleunigung [rad/s²]
param-max_jerk_rad_s3 = Höchster Ruck [rad/s³]
error-delta-outside-envelope = Das Ziel liegt außerhalb des Arbeitsraums.
error-delta-out-of-reach = Die Arme reichen nicht bis zum Ziel.
error-delta-joint-stop = Ein Arm müsste für das Ziel über seinen Anschlag hinaus.
error-delta-singularity = Das Ziel liegt zu nahe an einer Singularität der Kinematik.
