# Vendor trace import, the machine-free identification and the dataset checker.
error-import-layout = The trace file does not have the layout of its format: { $arg }
error-import-unit = Unknown unit, give `unit`, or `scale` to N m, in the mapping: { $arg }
error-import-per-rev = A unit that is not an angle needs `per_rev` (units per motor revolution) in the mapping: { $arg }
error-import-reference = A torque in percent or per mille needs `reference` (N m at 100 %) in the mapping: { $arg }
error-import-signal = The trace file has no signal { $arg }
error-import-ambiguous = More than one signal of the trace file matches { $arg }; give its full name.
error-import-map = The mapping file is missing or has a wrong value: { $arg }
error-import-time = The times of the trace cannot be put on one grid: { $arg }
note-import-skipped = Lines above the header skipped (metadata): { $arg }
note-import-time-ms = The time column has no unit and steps like a drive cycle in ms, so it is read in ms; give time_unit = "s" in the mapping if it is in seconds: { $arg }
error-identify-friction = Motor { $arg }: no inertia or friction fitted. The trace has to turn it both ways for at least 0.1 s each.
error-identify-lag = Motor { $arg }: no lag fitted. The trace has to start at rest and the setpoint has to change.
error-identify-two-mass = No two-mass model: the response needs a dip, a peak above it and three points below a third of the dip.
error-identify-ringing = No ringing found between the given times.
dataset-ok = Dataset { $arg }: no problems found.
dataset-problem = Dataset problem: { $arg }
error-identify-response = The trace is too short for a frequency response down to --from: it needs eight windows of four periods of the lowest frequency.
identify-inertia_kg_m2 = Total inertia at the motor [kg m²]
identify-viscous_nm_s_rad = Viscous friction [N m s/rad]
identify-coulomb_nm = Coulomb friction [N m]
identify-constant_torque_nm = Constant torque [N m]
identify-stiction_nm = Breakaway torque (Stribeck) [N m]
identify-stribeck_speed_rad_s = Stribeck speed [rad/s]
identify-presliding_stiffness_nm_rad = Presliding stiffness, LuGre σ0 [N m/rad]
identify-current_loop_gain = Current loop: gain
identify-current_loop_time_constant_s = Current loop: time constant [s]
identify-current_loop_dead_time_s = Current loop: dead time [s]
identify-position_loop_gain = Position loop: gain
identify-position_loop_time_constant_s = Position loop: time constant [s]
identify-position_loop_dead_time_s = Position loop: dead time [s]
identify-friction_model_fit_percent = Friction model reproduces the torque [%]
identify-friction_model_rms_nm = Friction model, RMS difference [N m]
identify-current_loop_fit_percent = Current loop model reproduces the torque [%]
identify-current_loop_following_error_fit_percent = Current loop model reproduces the torque error [%]
identify-position_loop_fit_percent = Position loop model reproduces the position [%]
identify-position_loop_following_error_fit_percent = Position loop model reproduces the following error [%]
