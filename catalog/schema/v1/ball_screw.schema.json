{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-drive-catalogue:schema:1:ball_screw",
  "$comment": "Schema 1 of the catalogue. Every value in SI units, given in each number's \"unit\"; an empty CSV field is a value the source does not give.",
  "title": "ball_screw",
  "description": "A ball screw drive: one size and lead. No data yet.",
  "type": "object",
  "required": [
    "part_number"
  ],
  "additionalProperties": false,
  "properties": {
    "part_number": {
      "type": "string",
      "description": "The maker's part number (order number), as printed."
    },
    "series": {
      "type": "string"
    },
    "nominal_diameter_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "lead_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "max_length_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "dynamic_load_rating_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "static_load_rating_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "preload_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "efficiency": {
      "type": "number",
      "minimum": 0,
      "unit": "1"
    },
    "max_speed_rad_s": {
      "type": "number",
      "minimum": 0,
      "unit": "rad/s"
    },
    "inertia_per_length_kgm2_m": {
      "type": "number",
      "minimum": 0,
      "unit": "kg m2/m"
    },
    "mass_per_length_kg_m": {
      "type": "number",
      "minimum": 0,
      "unit": "kg/m"
    },
    "axial_stiffness_n_m": {
      "type": "number",
      "minimum": 0,
      "unit": "N/m"
    },
    "backlash_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "lead_accuracy_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "source": {
      "type": "string",
      "description": "The id of the row's source in the table's metadata; without it, the metadata's default_source."
    }
  }
}
