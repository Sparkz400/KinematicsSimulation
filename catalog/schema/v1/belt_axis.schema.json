{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-drive-catalogue:schema:1:belt_axis",
  "$comment": "Schema 1 of the catalogue. Every value in SI units, given in each number's \"unit\"; an empty CSV field is a value the source does not give.",
  "title": "belt_axis",
  "description": "A linear axis or gantry driven by a toothed belt: one series and size. x is the horizontal axis, z the vertical one. Table torque_formula: the maker's formula for the required motor torque, one row per Z stroke.",
  "type": "object",
  "required": [
    "series",
    "size"
  ],
  "additionalProperties": false,
  "properties": {
    "axial_kit_part_number": {
      "type": "string"
    },
    "belt": {
      "type": "string"
    },
    "belt_elongation": {
      "type": "number",
      "minimum": 0,
      "unit": "1",
      "description": "The belt's strain at belt_elongation_force_n."
    },
    "belt_elongation_force_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "belt_material": {
      "type": "string"
    },
    "belt_pitch_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "belt_width_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "coupling_housing_part_number": {
      "type": "string"
    },
    "coupling_part_number": {
      "type": "string"
    },
    "feed_force_continuous_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "feed_force_peak_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "feed_per_rev_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "fx_dynamic_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "fx_static_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "fy_dynamic_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "fy_static_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "fz_dynamic_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "fz_static_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "kind": {
      "type": "string",
      "description": "axis, xy_gantry or xz_gantry for a belt axis; braking_module or braking_resistor for a braking resistor."
    },
    "mass_at_zero_stroke_kg": {
      "type": "number",
      "minimum": 0,
      "unit": "kg"
    },
    "mass_per_stroke_kg_m": {
      "type": "number",
      "minimum": 0,
      "unit": "kg/m"
    },
    "mass_per_stroke_z_kg_m": {
      "type": "number",
      "minimum": 0,
      "unit": "kg/m"
    },
    "max_acceleration_m_s2": {
      "type": "number",
      "minimum": 0,
      "unit": "m/s2"
    },
    "max_length_one_piece_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "max_length_x_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "max_length_y_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "max_length_z_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "max_no_load_torque_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "max_process_force_z_n": {
      "type": "number",
      "minimum": 0,
      "unit": "N"
    },
    "max_pulley_torque_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "max_speed_m_s": {
      "type": "number",
      "minimum": 0,
      "unit": "m/s"
    },
    "motor_part_number": {
      "type": "string"
    },
    "moved_mass_x_kg": {
      "type": "number",
      "minimum": 0,
      "unit": "kg"
    },
    "moved_mass_y_kg": {
      "type": "number",
      "minimum": 0,
      "unit": "kg"
    },
    "moved_mass_z_kg": {
      "type": "number",
      "minimum": 0,
      "unit": "kg"
    },
    "mx_dynamic_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "mx_static_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "my_dynamic_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "my_static_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "mz_dynamic_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "mz_static_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "no_load_torque_count": {
      "type": "number",
      "minimum": 0,
      "unit": "1",
      "description": "How many times no_load_torque_nm the document prints (e.g. 2 x 0.4 for a gantry with two motors)."
    },
    "no_load_torque_nm": {
      "type": "number",
      "minimum": 0,
      "unit": "N m"
    },
    "pulley_effective_diameter_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "pulley_teeth": {
      "type": "number",
      "minimum": 0,
      "unit": "1"
    },
    "rated_payload_kg": {
      "type": "number",
      "minimum": 0,
      "unit": "kg"
    },
    "repeatability_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "series": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "The id of the row's source in the table's metadata; without it, the metadata's default_source."
    },
    "stroke_x_max_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    },
    "stroke_x_min_m": {
      "type": "number",
      "minimum": 0,
      "unit": "m"
    }
  },
  "$defs": {
    "torque_formula": {
      "type": "object",
      "required": [
        "series",
        "size",
        "stroke_z_m"
      ],
      "additionalProperties": false,
      "properties": {
        "constant_kg_m": {
          "type": "number",
          "minimum": 0,
          "unit": "kg/m"
        },
        "gravity_factor_nm_kg": {
          "type": "number",
          "minimum": 0,
          "unit": "N m/kg"
        },
        "gravity_mass_kg": {
          "type": "number",
          "minimum": 0,
          "unit": "kg"
        },
        "load_factor_m": {
          "type": "number",
          "minimum": 0,
          "unit": "m"
        },
        "motor_inertia_factor_1_m": {
          "type": "number",
          "minimum": 0,
          "unit": "1/m"
        },
        "series": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "stroke_z_m": {
          "type": "number",
          "minimum": 0,
          "unit": "m"
        }
      },
      "description": "M = a (load_factor_m m_L + motor_inertia_factor_1_m J_m + constant_kg_m) + gravity_factor_nm_kg (gravity_mass_kg + m_L) + M_R, for travel at 45 degrees; a in m/s2, m_L the payload in kg, J_m the motor inertia in kg m2, M_R the friction torque."
    }
  }
}
